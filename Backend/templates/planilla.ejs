<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Planilla de Aprobación</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Helvetica:wght@400;700&display=swap');
        body {
            font-family: 'Helvetica', Arial, sans-serif;
            margin: 0;
            padding: 0;
            color: #333;
        }
        .header {
            background-color: #155dfc;
            color: white;
            padding: 30px 50px;
            height: 100px;
            box-sizing: border-box;
            position: relative;
        }
        .header h1 {
            margin: 0;
            font-size: 20px;
            font-weight: normal;
        }
        .header p {
            margin: 5px 0 0 0;
            font-size: 10px;
        }
        .content {
            padding: 30px 50px;
        }
        .expediente {
            color: #2c3e50;
            font-size: 14px;
            font-weight: bold;
            margin-top: 5px;
        }
        .fecha {
            position: absolute;
            right: 50px;
            top: 133px;
            font-size: 10px;
            color: #333;
        }
        hr {
            border: 0;
            border-top: 1.5px solid #155dfc;
            margin-top: 15px;
            margin-bottom: 20px;
        }
        .section-title {
            color: #2c3e50;
            font-size: 12px;
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
        }
        .info-row {
            margin-bottom: 15px;
            font-size: 11px;
            line-height: 1.4;
        }
        .info-label {
            font-weight: bold;
            color: #333;
        }
        .info-value {
            color: #555;
            margin-left: 5px;
        }
        .estado-pendiente { color: #f39c12; font-weight: bold; }
        .estado-aprobado { color: #27ae60; font-weight: bold; }
        .estado-rechazado { color: #e74c3c; font-weight: bold; }
        
        .caja-justificacion {
            color: #555;
            font-size: 11px;
            text-align: justify;
            margin-top: 5px;
            width: 100%;
        }

        /* Firmas */
        .firmas-container {
            margin-top: 150px;
            border-top: 1px solid #e0e0e0;
            padding-top: 80px;
            display: flex;
            justify-content: space-between;
            padding-left: 30px;
            padding-right: 30px;
        }
        .firma-box {
            text-align: center;
            width: 200px;
        }
        .firma-linea {
            border-top: 1px solid #333;
            margin-bottom: 5px;
        }
        .firma-texto {
            font-size: 10px;
            font-weight: bold;
            color: #2c3e50;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>PLANILLA DE APROBACIÓN DE SOLICITUD</h1>
        <p>CVG CABELUM - GESTIÓN DE COMPRAS E INVENTARIO</p>
    </div>
    
    <div style="position: relative; padding: 0 50px;">
        <div class="expediente">N° Expediente: #<%= solicitud.id_solicitud %></div>
        <div class="fecha">Fecha Impresión: <%= fechaAprobacion %></div>
        <hr>
    </div>

    <div class="content">
        <div class="section-title">Datos del Solicitante</div>
        <div class="info-row">
            Nombre Completo: <span class="info-value"><%= solicitud.nombres %> <%= solicitud.apellidos %></span><br>
            Cédula de Identidad: <span class="info-value"><%= solicitud.cedula || 'N/A' %></span><br>
            Gerencia / Departamento: <span class="info-value"><%= solicitud.nombre_gerencia %></span>
        </div>

        <div class="section-title">Especificaciones de la Solicitud</div>
        <div class="info-row">
            <span class="info-label">Estado Actual:</span> 
            <% if(solicitud.estado === 'Aprobado') { %>
                <span class="estado-aprobado">APROBADO</span>
            <% } else if (solicitud.estado === 'Rechazado') { %>
                <span class="estado-rechazado">RECHAZADO</span>
            <% } else { %>
                <span class="estado-pendiente"><%= solicitud.estado.toUpperCase() %></span>
            <% } %>
        </div>
        <div class="info-row">
            <span class="info-label">Monto Estimado:</span> 
            <span class="info-value" style="color: #2c3e50;">$<%= Number(solicitud.monto_estimado).toLocaleString('en-US') %></span>
        </div>
        <div class="info-row">
            <span class="info-label">Resumen del Proyecto:</span> 
            <div style="color: #555; margin-top: 5px;"><%= solicitud.resumen %></div>
        </div>
        <div class="info-row">
            <span class="info-label">Justificación Detallada:</span> 
            <div class="caja-justificacion"><%= solicitud.justificacion || 'Sin especificación detallada obligatoria por el usuario.' %></div>
        </div>

        <div class="firmas-container">
            <div class="firma-box">
                <div class="firma-linea"></div>
                <div class="firma-texto">Firma del Solicitante</div>
            </div>
            <div class="firma-box">
                <div class="firma-linea"></div>
                <div class="firma-texto">Sello y Firma Aprobatoria</div>
            </div>
        </div>
    </div>
</body>
</html>
